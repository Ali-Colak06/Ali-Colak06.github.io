---
import type { Locale } from '../../i18n/config';
import { ui } from '../../i18n/ui';
interface Props { locale: Locale; name: string }
const { locale, name } = Astro.props;
---
<footer class="site-footer">
  <div><p class="footer-name">{name}</p><p class="footer-credit">{ui[locale].footer}</p></div>
  <p class="copyright">© {new Date().getFullYear()} {name}</p>
</footer>
