---
import type { Locale } from '../../i18n/config';
import { ui } from '../../i18n/ui';
interface Props { locale: Locale }
const { locale } = Astro.props;
---
<button class="theme-toggle control" type="button" hidden data-dark-label={ui[locale].theme.dark} data-light-label={ui[locale].theme.light} aria-label={ui[locale].theme.dark}>
  <span aria-hidden="true">☾</span>
</button>
<script>
  const button = document.querySelector<HTMLButtonElement>('.theme-toggle');
  if (button) {
    const root = document.documentElement;
    const media = matchMedia('(prefers-color-scheme: dark)');
    let preference: string | null = null;
    try { preference = localStorage.getItem('portfolio-theme'); } catch { /* Storage may be disabled. */ }
    const apply = () => {
      const dark = preference === 'dark' || (preference !== 'light' && media.matches);
      root.dataset.theme = dark ? 'dark' : 'light';
      button.setAttribute('aria-label', (dark ? button.dataset.lightLabel : button.dataset.darkLabel)!);
      button.querySelector('span')!.textContent = dark ? '☀' : '☾';
    };
    apply();
    button.hidden = false;
    button.addEventListener('click', () => {
      preference = root.dataset.theme === 'dark' ? 'light' : 'dark';
      try { localStorage.setItem('portfolio-theme', preference); } catch { /* Keep the in-page choice. */ }
      apply();
    });
    media.addEventListener('change', apply);
    document.addEventListener('portfolio:locale-change', apply);
    window.addEventListener('storage', (event) => {
      if (event.key === 'portfolio-theme' || event.key === null) { preference = event.newValue; apply(); }
    });
  }
</script>
